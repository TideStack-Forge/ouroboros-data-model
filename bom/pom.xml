                <version>5.0.0</version>
            </dependency>
            <!-- Spring AI provider SDKs can lag behind newer platform dependencies on
                 error-prone annotations. Pin the harmless annotation artifact centrally
                 so mothership's real provider starter assembly remains convergent. -->
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${error-prone-annotations.version}</version>
            </dependency>
