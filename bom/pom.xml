            <!-- Spring AI 2.0.0 uses victools for model-side schema generation. This is not
                 the project-side JSON Schema validation API; application validation should
                 go through the project-approved JSON Schema validation helper. Pin these
                 transitive versions so Maven Enforcer convergence remains deterministic. -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>3.1.4</version>
            </dependency>
            <dependency>
