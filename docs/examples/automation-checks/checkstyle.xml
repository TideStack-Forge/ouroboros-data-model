<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Ouroboros Checkstyle 配置（Task 0.3 baseline）
  仅保留红线规则，存量风格问题后续分阶段治理。
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">

    <!-- P0-1: 禁止异常吞噬 -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignore|ignored"/>
      <property name="commentFormat" value="This is expected"/>
      <message key="catch.block.empty"
               value="[P0-1] 禁止异常吞噬：不得使用空 catch 块或 catch (Exception ignored)。必须记录日志或抛出异常。详见 DESIGN.md"/>
    </module>

    <!-- P0-2: 禁止未实现的 TODO -->
    <module name="TodoComment">
      <property name="format" value="TODO:\s*implement"/>
      <message key="todo.match"
               value="[P0-2] 禁止未实现的 TODO：不得提交包含 'TODO: implement' 的代码。必须实现或抛出 UnsupportedOperationException。"/>
    </module>

    <!-- P0-4: 禁止 SQL 注入风险 -->
    <module name="Regexp">
      <property name="format" value="&quot;\s*SELECT\s+.*\+"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="[P0-4] 禁止 SQL 注入风险：不得拼接 SQL 字符串。必须使用参数化查询。"/>
    </module>

    <!-- Task 0.3 范围说明：P1-9(@SuppressWarnings unchecked/rawtypes) 暂不纳入 active checkstyle gate，
         统一在 scripts/quality/suppresswarnings-allowlist.tsv 记录存量债务并后续接入独立 ratchet 阶段。 -->

    <!-- P0-5: 禁止敏感信息泄露 -->
    <module name="Regexp">
      <property name="format" value="log\.(info|debug|warn|error).*(password|token|secret|Password|Token|Secret)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="[P0-5] 禁止敏感信息泄露：日志中不得包含密码、Token 等敏感信息。"/>
    </module>

  </module>
</module>
